{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "R HTML",
  "version": "../package.json",
  "identifier": "com.runbrick.rhtml",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "R HTML",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/runbrick/r-html/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGMDUzNjVFMzY3Q0ExRTUKUldUbG9YdzJYallGVDg4TEd2NmxhbElIQ2ljYXBWWmRaREEyRTFteE4xZkU4VzJmTnFrR3RRT3QK"
    }
  }
}
